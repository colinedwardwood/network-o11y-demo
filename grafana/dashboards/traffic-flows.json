    {
      "id": 2,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "datasource": null,
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "<div style=\"padding:10px 16px;font-size:14px;line-height:1.65;\">\n<p style=\"margin:0 0 8px 0;\">\n  <strong>Network O11y \u2014 Fabric Traffic</strong> shows per-interface ingress and egress byte\n  and packet rates across the entire fabric, plus fabric-wide aggregate totals. Use the\n  <em>Device</em> variable to focus on a single switch.\n</p>\n<p style=\"margin:0;\">\n  <strong>Telemetry pipeline:</strong>\n  Interface statistics are collected via <strong>gNMI streaming telemetry</strong>. gnmic\n  subscribes to <code>/interface[name=*]/statistics/</code> on each SR Linux node and\n  exports in/out octet and packet counters as Prometheus metrics. Grafana Alloy scrapes\n  the gnmic endpoint every 30 s and forwards data to Grafana Cloud.\n</p>\n</div>",
        "mode": "html"
      },
      "pluginVersion": "10.0.0",
      "transparent": true
    },
    {
      "id": 3,
      "type": "row",
      "title": "",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total Fabric In (last 5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bits",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(srl_iface_in_octets{job=\"integrations/gnmi\"}[5m])) * 8",
          "legendFormat": "Bits",
          "refId": "A",
          "editorMode": "code",
          "range": false,
          "instant": true
